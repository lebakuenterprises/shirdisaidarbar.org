---
import '../styles/tokens.css';
import '../styles/bundle.css';
import '../styles/site.css';
import schedule from '../data/schedule.json';
import { directionsUrl, site } from '../lib/site';

interface Props { title: string; description: string; jsonLd?: boolean; noindex?: boolean }
const { title, description, jsonLd = false, noindex = false } = Astro.props;
// The page's own address: pages are built as files (privacy.html), served without the extension.
const pageUrl = new URL(Astro.url.pathname.replace(/(index)?\.html$/, ''), site.url);
const DOW = ['Sunday', 'Monday', 'Tuesday', 'Wednesday', 'Thursday', 'Friday', 'Saturday'];
const ld = {
  '@context': 'https://schema.org',
  '@type': ['HinduTemple', 'NGO'],
  name: site.name,
  description: 'A volunteer-run Shirdi Sai Baba mandir in Sunnyvale, California.',
  url: `${site.url}/`,
  image: `${site.url}/img/og-image.jpg`,
  logo: `${site.url}/img/icon-512.png`,
  telephone: site.phone.e164,
  email: site.email,
  taxID: site.ein,
  nonprofitStatus: 'Nonprofit501c3',
  geo: { '@type': 'GeoCoordinates', latitude: site.geo.lat, longitude: site.geo.lon },
  hasMap: directionsUrl,
  address: { '@type': 'PostalAddress', streetAddress: site.address.street, addressLocality: site.address.city, addressRegion: site.address.region, postalCode: site.address.postal, addressCountry: 'US' },
  openingHoursSpecification: schedule.hours.flatMap((h) => h.windows.map(([opens, closes]) => ({ '@type': 'OpeningHoursSpecification', dayOfWeek: h.days.map((d) => DOW[d]), opens, closes }))),
  sameAs: site.social.map((s) => s.url),
};
---
<!doctype html>
<html lang="en" class:list={{ 'is-dev': import.meta.env.DEV }}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="theme-color" content="#FBF7EF" media="(prefers-color-scheme: light)" />
    <meta name="theme-color" content="#140E0B" media="(prefers-color-scheme: dark)" />
    {noindex ? <meta name="robots" content="noindex" /> : <link rel="canonical" href={pageUrl} />}
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={site.name} />
    <meta property="og:locale" content="en_US" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={pageUrl} />
    <meta property="og:image" content={`${site.url}/img/og-image.jpg`} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content="Shirdi Sai Darbar, the Shirdi Sai Baba temple in Sunnyvale" />
    <meta name="twitter:card" content="summary_large_image" />
    <link rel="icon" href="/img/favicon-32.png" sizes="32x32" type="image/png" />
    <link rel="apple-touch-icon" href="/img/apple-touch-icon.png" />
    <link rel="manifest" href="/site.webmanifest" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <script is:inline>
      // Day (Kakad) or Night (Shej): the visitor's choice, else the device setting. Set before paint, no flash.
      (function () {
        var t; try { t = localStorage.getItem('sd-theme'); } catch (e) {}
        if (t !== 'day' && t !== 'night') t = matchMedia('(prefers-color-scheme: dark)').matches ? 'night' : 'day';
        document.documentElement.dataset.theme = t;
      })();
    </script>
    <slot name="head" />
    {jsonLd && <script type="application/ld+json" set:html={JSON.stringify(ld)} />}
  </head>
  <body>
    <slot />
  </body>
</html>
