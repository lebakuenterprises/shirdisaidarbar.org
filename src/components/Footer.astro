---
import Flame from './Flame.astro';
import Icon from './Icon.astro';
import type { IconName } from './icons';
import { fullAddress, linkAttrs, site } from '../lib/site';
---
<footer class="sd-footer sd-kolam" id="contact">
  <div class="sd-toran" aria-hidden="true"></div>
  <div class="sd-footer__in">
    <div>
      <img class="sd-footer__seal sd-on-day" src="/img/seal-day.webp" width="96" height="96" loading="lazy" decoding="async" alt="Shirdi Sai Darbar seal: Sabka Malik Ek, Shraddha, Saburi" />
      <img class="sd-footer__seal sd-on-night" src="/img/seal-night.webp" width="96" height="96" loading="lazy" decoding="async" alt="Shirdi Sai Darbar seal: Sabka Malik Ek, Shraddha, Saburi" />
      <p class="sd-footer__name">{site.name}</p>
      <address class="sd-address">{fullAddress}<br /><a href={`sms:${site.phone.e164}`}>{site.phone.display}</a> ({site.phone.note})<br /><a href={`mailto:${site.email}`}>{site.email}</a></address>
    </div>
    <div><h3>More from the Darbar</h3><ul>
      <li><a {...linkAttrs(site.links.shop)}>Gift shop</a></li>
      <li><a {...linkAttrs(site.links.priestService)}>Priest services</a></li>
      <li><a {...linkAttrs(site.links.volunteer)}>Volunteer with us</a></li>
      <li><a {...linkAttrs(site.links.photos)}>Photo albums</a></li>
      <li><a {...linkAttrs(site.links.sisterTemple)}>Bay Area Hindu Temple</a> <span class="sd-small">(sister temple)</span></li>
    </ul></div>
    <div><h3>Follow the Darbar</h3><ul class="sd-social">
      {site.social.map((s) => <li><a {...linkAttrs(s.url)}><Icon name={s.icon as IconName} />{s.name}</a></li>)}
    </ul></div>
    <div class="sd-signoff"><Flame /><p class="sd-signoff__hi" lang="hi">सबका मालिक एक</p><p class="sd-signoff__en">Sabka Malik Ek. One God governs all.</p></div>
    <p class="sd-footer__legal"><span>501(c)(3) nonprofit, EIN {site.ein}</span><span>&copy; <span data-year>{new Date().getFullYear()}</span> {site.name}</span><a {...linkAttrs('/privacy')}>Privacy</a></p>
  </div>
</footer>
